{
  "name": "jooq-antipattern-detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.21",
  "bin": {
    "jooq-antipattern-detector": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target bun --outfile ./dist/jooq-antipattern-detector",
    "build:native": "bun build ./src/cli.ts --compile --outfile ./dist/jooq-antipattern-detector",
    "check": "tsc --noEmit",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check:all": "bun run check && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.18",
    "@ai-sdk/openai": "^1.3.22",
    "ai": "^4.3.16",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "p-limit": "^6.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.13.10",
    "bun-types": "^1.3.10",
    "typescript": "^5.8.2"
  }
}
